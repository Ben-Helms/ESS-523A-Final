  summarise(across(c(DBH, Height, CBH, `Tree density`, `Basal area`), 
              ~round(APE(.x[method == "MAN"], .x[method == "MS"]), 1),
      .names = "APE_{.col}"))

MS_USFS_APE <- MS_APE %>%
