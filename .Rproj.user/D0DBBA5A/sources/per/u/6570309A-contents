SS_APE_and_Occ <- full_join(SS_APE, Covars, by = "Plot") %>%
  dplyr::select(c(Site, Plot, APE_DBH, APE_Height, APE_CBH, `APE_Tree density`, `APE_Basal area`, SS_Total_Occlusion, SS_Occlusion_2m))

Total_Occ_models <- SS_APE_and_Occ %>%
  nest() %>%
  mutate(
    #DBH
    DBH_model = map(data, ~lmer(sqrt(APE_DBH) ~ sqrt(SS_Total_Occlusion) + (1 | Site), data = .x)),
