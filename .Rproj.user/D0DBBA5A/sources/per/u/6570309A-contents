#### **Table 3.** The percentage of single-scan and multi-scan plots with absolute percent errors that meet the 10% maximum error threshold outlined by the US Forest Service for plot-based field surveys of diameter at breast height (DBH), height, canopy base height (CBH), tree density, and the combination of all four parameters.

```{r include=FALSE}
#Function to calculate APE
APE <- function(FS, TLS){
  (abs(FS-TLS)/(abs(FS)))*100
}

SS_APE <- SS_C1_T2 %>%
  group_by(Plot) %>%
  rename(DBH = `DBH (cm)`, Height = `Height (m)`, CBH = `CBH (m)`, `Tree density` = `Tree density (trees ha-1)`, `Basal area` = `Basal area (m2 ha-1)`) %>%
  summarise(across(c(DBH, Height, CBH, `Tree density`, `Basal area`), 
              ~round(APE(.x[method == "MAN"], .x[method == "SS"]), 1),
      .names = "APE_{.col}"))

SS_USFS_APE <- SS_APE %>%
  select(-c("APE_Basal area")) %>%
  mutate(Total_pass = if_all(starts_with("APE_"), ~ .x <= 10)) %>%
  summarise(`DBH (%)` = round((length(which(APE_DBH <= 10))/n())*100),
            `Height (%)` = round((length(which(APE_Height <= 10))/n())*100),
            `CBH (%)` = round((length(which(APE_CBH <= 10))/n())*100),
            `Tree density (%)` = round((length(which(`APE_Tree density` <= 10))/n())*100), 
            `Total (%)` = round((sum(Total_pass, na.rm = TRUE) / n()) * 100))

