# Random forest variable importance:
RF_imp <- RF_important_vars %>%
distinct(Fold, Repeat, Predictor, Dataset) %>%
count(Dataset, Predictor, name = "n_runs") %>%
left_join(
RF_important_vars %>%
distinct(Dataset, Fold, Repeat) %>%
count(Dataset, name = "total_runs"),
by = "Dataset"
) %>%
mutate(perc = 100 * n_runs / total_runs)
# read in data
# Fuel load and variables
fuelLoad <- read.csv("data/chapter2/Surface_Fuel_Full.csv")
# Model performance
SF_results <- read.csv("data/chapter2/SF_model_results.csv") %>%
mutate(fuelType = case_match(fuelType,
"Litter_1h" ~ "Fine dead surface fuels",
"Large_diam_woody" ~ "Large-diameter DDW",
"Herb" ~ "Herbaceous fuels",
"Shrub" ~ "Live woody fuels",
"SF_bio" ~ "Total surface fuels"))
SF_results$model <- factor(SF_results$model, levels = c("Random Forest", "Elastic Net", "Leaps and Bounds"))
SF_results$fuelType <- factor(SF_results$fuelType, levels = c("Fine dead surface fuels", "Large-diameter DDW", "Herbaceous fuels", "Live woody fuels", "Total surface fuels"))
# Variable importance
RF_important_vars <- read.csv("data/chapter2/RF_manCV_varImp.csv")
EN_important_vars <- read.csv("data/chapter2/Pen_manCV_varImp.csv")
LB_important_vars <- read.csv("data/chapter2/LB_manCV_varImp.csv")%>%
rename(Predictor = Term)
# Random forest variable importance:
RF_imp <- RF_important_vars %>%
distinct(Fold, Repeat, Predictor, Dataset) %>%
count(Dataset, Predictor, name = "n_runs") %>%
left_join(
RF_important_vars %>%
distinct(Dataset, Fold, Repeat) %>%
count(Dataset, name = "total_runs"),
by = "Dataset"
) %>%
mutate(perc = 100 * n_runs / total_runs)
RF_floor <- RF_imp %>%
filter(perc >= 75)
RF_predictors_above_75 <- RF_floor %>%
dplyr::select(-c(n_runs, total_runs))
RF_Imp_75_var <- RF_important_vars %>%
inner_join(RF_floor %>% dplyr::select(Dataset, Predictor, ),
by = c("Dataset", "Predictor"))
RF_Imp_75_var$Dataset <- dplyr::recode(RF_Imp_75_var$Dataset,
SF_bio = "Total surface fuels",
Herb = "Herbaceous fuels",
Shrub = "Live woody fuels",
Large_diam_woody = "Large-diameter DDW",
Litter_1h = "Fine dead surface fuels")
RF_Imp_75_var$Dataset <- factor(RF_Imp_75_var$Dataset, levels = c("Fine dead surface fuels", "Large-diameter DDW", "Herbaceous fuels", "Live woody fuels", "Total surface fuels"))
p1 <- ggplot(RF_Imp_75_var, aes(x = Importance, y = Predictor, fill = Dataset)) +
geom_boxplot(width = 1, position = position_dodge2(preserve = "single")) +
theme(panel.spacing.y = unit(2, "lines")) +
ggtitle("Random Forest") +
labs(x = "Variable Importance", y = NULL) +
scale_x_log10(labels = scales::label_number(),
breaks = scales::log_breaks(n = 6)) +
facet_wrap(~ Dataset, nrow = 5, scales = "free_y") +
scale_fill_viridis_d(option = "E") +
theme(plot.background  = element_blank(),
panel.background = element_blank(),
legend.position = "none",
text = element_text(family = "Times New Roman"),
plot.title = element_text(size = 15, face = "bold", hjust = 0.5),
axis.text.y = element_text(size = 12),
axis.title.x = element_text(size = 12, face = "bold", margin = ggplot2::margin(t = 15)),
axis.text = element_text(size = 12, color = "black"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.border     = element_rect(color = "black", fill = NA, linewidth = 0.5),
strip.background = element_rect(fill = "transparent", color = "black"),
strip.text = element_text(hjust = 0.5, size = 12, face = "bold")
)
# Elastic Net coefficent magnitiude
EN_imp <- EN_important_vars %>%
distinct(Fold, Repeat, Predictor, Dataset) %>%
count(Dataset, Predictor, name = "n_runs") %>%
left_join(
EN_important_vars %>%
distinct(Dataset, Fold, Repeat) %>%
count(Dataset, name = "total_runs"),
by = "Dataset"
) %>%
mutate(perc = 100 * n_runs / total_runs)
EN_floor <- EN_imp %>%
filter(perc >= 75) %>%
dplyr::select(Dataset, Predictor)
EN_Imp_75_var <- EN_important_vars %>%
semi_join(EN_floor, by = c("Dataset", "Predictor")) %>%
bind_rows(
EN_important_vars %>%
distinct(Dataset) %>%
anti_join(EN_floor, by = "Dataset") %>%
mutate(Predictor = NA, Coefficient = NA)
)
EN_Imp_75_var$Dataset <- dplyr::recode(EN_Imp_75_var$Dataset,
SF_bio = "Total surface fuels",
Herb = "Herbaceous fuels",
Shrub = "Live woody fuels",
Large_diam_woody = "Large-diameter DDW",
Litter_1h = "Fine dead surface fuels")
EN_Imp_75_var$Dataset <- factor(EN_Imp_75_var$Dataset, levels = c("Fine dead surface fuels", "Large-diameter DDW", "Herbaceous fuels", "Live woody fuels", "Total surface fuels"))
viridis_cols <- viridis::viridis(5, option = "E")
dataset_cols <- setNames(
viridis::viridis(5, option = "E"),
levels(EN_Imp_75_var$Dataset))
p2 <- ggplot(EN_Imp_75_var, aes(x = Coefficient, y = Predictor, fill = Dataset)) +
geom_boxplot(width = 0.4) +
ggtitle("Elastic Net") +
labs(x = "Coefficient Magnitude", y = NULL) +
scale_x_continuous(
trans = scales::pseudo_log_trans(base = 10),
labels = scales::label_number(),
breaks = scales::pretty_breaks(n = 6)) +
facet_wrap(~ Dataset, nrow = 5, scales = "free_y") +
scale_fill_manual(values = dataset_cols) +
theme(plot.background  = element_blank(),
panel.background = element_blank(),
legend.position = "none",
text = element_text(family = "Times New Roman"),
plot.title = element_text(size = 15, face = "bold", hjust = 0.5),
axis.text.y = element_text(size = 12, margin = ggplot2::margin(t = 20)),
axis.title.x = element_text(size = 12, face = "bold", margin = ggplot2::margin(t = 15)),
axis.text = element_text(size = 12, color = "black"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.border     = element_rect(color = "black", fill = NA, linewidth = 0.5),
strip.background = element_rect(fill = "transparent", color = "black"),
strip.text = element_text(hjust = 0.5, size = 12, face = "bold")
)
# Leaps and Bounds coefficen magnitiude
LB_imp <- LB_important_vars %>%
distinct(Fold, Repeat, Predictor, Dataset) %>%
count(Dataset, Predictor, name = "n_runs") %>%
left_join(
LB_important_vars %>%
distinct(Dataset, Fold, Repeat) %>%
count(Dataset, name = "total_runs"),
by = "Dataset"
) %>%
mutate(perc = 100 * n_runs / total_runs)
LB_floor <- LB_imp %>%
filter(perc >= 75) %>%
dplyr::select(Dataset, Predictor)
LB_Imp_75_var <- LB_important_vars %>%
semi_join(LB_floor, by = c("Dataset", "Predictor")) %>%
bind_rows(
LB_important_vars %>%
distinct(Dataset) %>%
anti_join(LB_floor, by = "Dataset") %>%
mutate(Predictor = NA, coefficient = NA)
)
LB_Imp_75_var$Dataset <- dplyr::recode(
LB_Imp_75_var$Dataset,
SF_bio = "Total surface fuels",
Herb = "Herbaceous fuels",
Shrub = "Live woody fuels",
Large_diam_woody = "Large-diameter DDW",
Litter_1h = "Fine dead surface fuels"
)
LB_Imp_75_var$Dataset <- factor(
LB_Imp_75_var$Dataset,
levels = c(
"Fine dead surface fuels",
"Large-diameter DDW",
"Herbaceous fuels",
"Live woody fuels",
"Total surface fuels"
)
)
dataset_cols <- setNames(
viridis::viridis(5, option = "E"),
levels(LB_Imp_75_var$Dataset)
)
p3 <- ggplot(LB_Imp_75_var, aes(x = coefficient, y = Predictor, fill = Dataset)) +
geom_boxplot(width = 0.4) +
ggtitle("Leaps and Bounds") +
labs(x = "Coefficient Magnitude", y = NULL) +
scale_x_log10(labels = scales::label_number(),
breaks = scales::log_breaks(n = 6)) +
facet_wrap(~ Dataset, nrow = 5, scales = "free_y") +
scale_fill_manual(values = dataset_cols) +
scale_y_discrete(expand = expansion(mult = c(0.05, 0.05))) +
theme(plot.background  = element_blank(),
panel.background = element_blank(),
legend.position = "none",
text = element_text(family = "Times New Roman"),
plot.title = element_text(size = 15, face = "bold", hjust = 0.5),
axis.text.y = element_text(size = 12),
axis.title.x = element_text(size = 12, face = "bold", margin = ggplot2::margin(t = 15)),
axis.text = element_text(size = 12, color = "black"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.border     = element_rect(color = "black", fill = NA, linewidth = 0.5),
strip.background = element_rect(fill = "transparent", color = "black"),
strip.text = element_text(hjust = 0.5, size = 12, face = "bold"))
p1+p2+p3
View(RF_imp)
