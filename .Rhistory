rename(Plot = Plot.Name) %>%
group_by(Plot) %>%
mutate(BA = (pi*(DBH.m.^2))/4) %>%
summarize(`DBH (cm)` = mean(DBH.m.*100),
`Height (m)` = mean(HT.m.),
`CBH (m)` = mean(CBH.m., na.rm = T),
`Tree density (trees ha-1)` = round(n()/0.04047),
`Basal area (m2 ha-1)` = (sum(BA)/0.04047))%>%
ungroup()
avgMan <- avgMan %>% mutate(method = "MAN")
avgSS  <- avgSS  %>% mutate(method = "SS")
avgMS  <- avgMS  %>% mutate(method = "MS")
C1_T1 <- avgMan %>%
summarize(across(
c(`DBH (cm)`, `Height (m)`, `CBH (m)`, `Tree density (trees ha-1)`, `Basal area (m2 ha-1)`),
list(
Min  = ~round(min(.x), 1),
Mean = ~round(mean(.x), 1),
Max  = ~round(max(.x), 1),
SD   = ~round(sd(.x), 1),
`CV (%)` = ~round((sd(.x) / mean(.x)*100))
), .names = "{.col}_{.fn}")) %>%
pivot_longer(
cols = everything(),
names_to = c("Attribute", "stat"),
names_sep = "_",
values_to = "value") %>%
pivot_wider(
names_from = stat,
values_from = value)
SS_C1_T2 <- bind_rows(avgMan, avgSS)
MS_C1_T2 <- bind_rows(avgMan, avgMS)
View(C1_T1)
# Read in data
Man <- read.csv("data/chapter1/Manual_Inventory_Tree_List.csv")
SS <- read.csv("data/chapter1/SingleScan_Tree_List.csv")
MS <- read.csv("data/chapter1/MultiScan_Tree_List.csv")
Covars <- read.csv("data/chapter1/Covariates.csv")
# Averages
avgMan <- Man %>%
group_by(Plot) %>%
summarize(`DBH (cm)` = mean(DBH.cm.),
`Height (m)` = mean(Height.m.),
`CBH (m)` = mean(CBH.m., na.rm = T),
`Tree density (trees ha-1)` = round(n()/0.04047),
`Basal area (m2 ha-1)` = (sum(BasalA.m2.)/0.04047)) %>%
ungroup()
avgSS <- SS %>%
rename(Plot = Plot.Name) %>%
group_by(Plot) %>%
mutate(BA = (pi*(DBH.m.^2))/4,
Plot = sub("_C$", "", Plot)) %>%
summarize(`DBH (cm)` = mean(DBH.m.*100),
`Height (m)` = mean(HT.m.),
`CBH (m)` = mean(CBH.m., na.rm = T),
`Tree density (trees ha-1)` = round(n()/0.04047),
`Basal area (m2 ha-1)` = (sum(BA)/0.04047)) %>%
ungroup()
avgMS <- MS %>%
rename(Plot = Plot.Name) %>%
group_by(Plot) %>%
dplyr::select("Plot", "DBH.m.", "HT.m.", "CBH.m.", "Unique_treeID") %>%
mutate(BA = (pi*(DBH.m.^2))/4) %>%
summarize(`DBH (cm)` = mean(DBH.m.*100),
`Height (m)` = mean(HT.m.),
`CBH (m)` = mean(CBH.m., na.rm = T),
`Tree density (trees ha-1)` = round(n()/0.04047),
`Basal area (m2 ha-1)` = (sum(BA)/0.04047))%>%
ungroup()
avgMan <- avgMan %>% mutate(method = "MAN")
avgSS  <- avgSS  %>% mutate(method = "SS")
avgMS  <- avgMS  %>% mutate(method = "MS")
C1_T1 <- avgMan %>%
summarize(across(
c(`DBH (cm)`, `Height (m)`, `CBH (m)`, `Tree density (trees ha-1)`, `Basal area (m2 ha-1)`),
list(
Min  = ~round(min(.x), 1),
Mean = ~round(mean(.x), 1),
Max  = ~round(max(.x), 1),
SD   = ~round(sd(.x), 1),
`CV (%)` = ~round((sd(.x) / mean(.x)*100))
), .names = "{.col}_{.fn}")) %>%
pivot_longer(
cols = everything(),
names_to = c("Attribute", "stat"),
names_sep = "_",
values_to = "value") %>%
pivot_wider(
names_from = stat,
values_from = value)
SS_C1_T2 <- bind_rows(avgMan, avgSS)
MS_C1_T2 <- bind_rows(avgMan, avgMS)
C1_T1$Attribute[C1_T1$Attribute == "Tree density (trees ha-1)"] <- "Tree density (trees ha<sup>-1</sup>)"
C1_T1$Attribute[C1_T1$Attribute == "Basal area (m2 ha-1)"]    <- "Basal area (m<sup>2</sup> ha<sup>-1</sup>)"
gt(C1_T1) %>%
fmt_markdown(columns = Attribute) %>%
tab_options(
heading.title.font.size = px(16),
table.width = pct(100),
column_labels.font.weight = "bold"
) %>%
cols_align(align = "center", columns = everything())
282.5/0.04
282.5*0.04
297*0.04
View(SS_C1_T2)
#single scan errors
SS_corr <- SS_C1_T2 %>%
summarise(
across(c(`DBH (cm)`,
`Height (m)`,
`CBH (m)`,
`Tree density (trees ha-1)`,
`Basal area (m2 ha-1)`),
~round(cor(.x[method == "MAN"], .x[method == "SS"], method = "spearman"), 2),
.names = "R_{.col}"),
.groups = "drop") %>%
pivot_longer(
cols = everything(),
names_to = c("Statistic", "Metric"),
names_pattern = "^(.*?)_{1}(.*)$",
values_to = "value"
) %>%
pivot_wider(
names_from = Metric,
values_from = value
)
SS_corr %>%
gt() %>%
cols_label(`Tree density (trees ha-1)` = html("Tree density (trees ha<sup>-1</sup>)"),
`Basal area (m2 ha-1)` = html("Basal area (m<sup>2</sup> ha<sup>-1</sup>)")) %>%
tab_header(
title = "Correlation coefficient (R) between single-scan and manual estimates",
) %>%
tab_options(
heading.title.font.size = px(16),
table.width = pct(100),
column_labels.font.weight = "bold") %>%
cols_align(align = "center", columns = everything())
SS_absError %>%
gt() %>%
tab_header(
title = "Single-scan absolute error",
) %>%
cols_label(
Statistic = "Statistic",
`AE_DBH (cm)` = "DBH (cm)",
`AE_Height (m)` = "Height (m)",
`AE_CBH (m)` = "CBH (m)",
`AE_Height (m)` = "Height (m)",
`AE_Tree density (trees ha-1)` = html("Tree density (trees ha<sup>-1</sup>)"),
`AE_Basal area (m2 ha-1)` = html("Basal area (m<sup>2</sup> ha<sup>-1</sup>)")
) %>%
fmt_number(
columns = everything(),
decimals = 2
) %>%
tab_options(
heading.title.font.size = px(16),
table.width = pct(100),
column_labels.font.weight = "bold")%>%
cols_align(align = "center", columns = everything())
#Function to calculate AE
AE <- function(FS, TLS){
abs(FS-TLS)
}
#Bias function (negative values show TLS Under prediction)
bias <- function(FS, TLS) {
-(FS - TLS)
}
#single scan errors
SS_corr <- SS_C1_T2 %>%
summarise(
across(c(`DBH (cm)`,
`Height (m)`,
`CBH (m)`,
`Tree density (trees ha-1)`,
`Basal area (m2 ha-1)`),
~round(cor(.x[method == "MAN"], .x[method == "SS"], method = "spearman"), 2),
.names = "R_{.col}"),
.groups = "drop") %>%
pivot_longer(
cols = everything(),
names_to = c("Statistic", "Metric"),
names_pattern = "^(.*?)_{1}(.*)$",
values_to = "value"
) %>%
pivot_wider(
names_from = Metric,
values_from = value
)
SS_absError <- SS_C1_T2 %>%
group_by(Plot) %>%
summarise(across(c(`DBH (cm)`,
`Height (m)`,
`CBH (m)`,
`Tree density (trees ha-1)`,
`Basal area (m2 ha-1)`),
~round(AE(.x[method == "MAN"], .x[method == "SS"]), 1),
.names = "AE_{.col}")) %>%
summarise(across(
starts_with("AE_"),
list(Min = min, Median = median, Max = max),
.names = "{.fn}_{.col}")) %>%
pivot_longer(
cols = everything(),
names_to = c("Statistic", "Metric"),
names_pattern = "^(.*?)_{1}(.*)$",
values_to = "value"
) %>%
pivot_wider(
names_from = Metric,
values_from = value
)
SS_Bias <- SS_C1_T2 %>%
group_by(Plot) %>%
summarise(
across(c(`DBH (cm)`,
`Height (m)`,
`CBH (m)`,
`Tree density (trees ha-1)`,
`Basal area (m2 ha-1)`),
~round(bias(.x[method == "MAN"], .x[method == "SS"]), 1),
.names = "bias_{.col}"),
.groups = "drop") %>%
summarise(across(
starts_with("bias_"),
list(Min = min, Median = median, Max = max),
.names = "{.fn}_{.col}")) %>%
pivot_longer(
cols = everything(),
names_to = c("Statistic", "Metric"),
names_pattern = "^(.*?)_{1}(.*)$",
values_to = "value"
) %>%
pivot_wider(
names_from = Metric,
values_from = value
)
